{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banodoco.dev/workspace/v1/schemas/timeline-inspection.json",
  "title": "Declared timeline inspection options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "occurrence": { "type": "string", "minLength": 1, "maxLength": 256 },
    "shot": { "type": "string", "minLength": 1, "maxLength": 256 },
    "clip": { "type": "string", "minLength": 1, "maxLength": 256 },
    "asset": { "type": "string", "minLength": 1, "maxLength": 256 },
    "track": { "type": "string", "minLength": 1, "maxLength": 256 },
    "range": { "oneOf": [ { "type": "string" }, { "type": "array", "minItems": 2, "maxItems": 2 } ] },
    "neighbors": { "type": "integer", "minimum": 0, "maximum": 2 },
    "detail": { "type": "boolean" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "formats": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["md", "png"] } }
  }
}
