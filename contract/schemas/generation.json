{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banodoco.dev/workspace/v1/schemas/generation.json",
  "title": "Minimal neutral generation and variant records",
  "type": "object", "additionalProperties": false,
  "required": ["generation_id", "project_id", "type", "status", "metadata", "version", "created_at", "updated_at"],
  "properties": {
    "generation_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "source_task_id": { "type": ["string", "null"] },
    "type": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object", "additionalProperties": true },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
