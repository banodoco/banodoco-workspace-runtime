{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banodoco.dev/workspace/v1/schemas/realm.json",
  "title": "Scoped workspace realm",
  "type": "object", "additionalProperties": false,
  "required": ["realm_id", "display_name", "version", "created_at"],
  "properties": {
    "realm_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
    ,"state": { "enum": ["active", "tombstoned"] },
    "tombstoned_at": { "type": ["string", "null"] },
    "lifecycle_version": { "type": "integer", "minimum": 1 }
  }
}
